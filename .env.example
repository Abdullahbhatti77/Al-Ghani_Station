# PumpHisab environment template. Copy to .env and fill in. Never commit .env.

# --- Public client configuration (bundled into the browser; safe to expose) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Server-side copies used during SSR (same public values) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# --- Server-only secrets (NOT needed by current app code) ---
# The generated admin client reads SUPABASE_SERVICE_ROLE_KEY, but no app code
# uses it today. If you ever need it, set it only in the hosting secret store.
# SUPABASE_SERVICE_ROLE_KEY=
